# ---- Database ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=tkb_db

# ---- Auth ----
JWT_SECRET=changeme_jwt_secret_at_least_32_chars
# Bắt buộc: backend sẽ không khởi động nếu thiếu hoặc ngắn hơn 32 ký tự

# ---- URLs ----
# IMPORTANT: Set this to your actual domain in production
# Production: https://api.gettimetable.cloud
# Local dev:  http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Danh sách origin được phép gọi API, phân tách bằng dấu phẩy
CORS_ORIGIN=http://localhost:3000

# ---- Ports (optional) ----
BE_PORT=4000
FE_PORT=3000
