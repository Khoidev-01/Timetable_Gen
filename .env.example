# ---- Database ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=tkb_db

# ---- Auth ----
JWT_SECRET=changeme_jwt_secret_at_least_32_chars
# Bắt buộc: backend sẽ không khởi động nếu thiếu hoặc ngắn hơn 32 ký tự

# ---- URLs ----
# IMPORTANT: Set this to your actual domain in production
# Production: https://api.gettimetable.cloud
# Local dev:  http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Danh sách origin được phép gọi API, phân tách bằng dấu phẩy
CORS_ORIGIN=http://localhost:3000

# ---- Ports (optional) ----
BE_PORT=4000
FE_PORT=3000

# ---- Trợ lý AI ----
# Nhận mọi endpoint theo dạng OpenAI /chat/completions.
# Không đặt thì trợ lý tự tắt, phần còn lại của hệ thống không ảnh hưởng.
#   OpenAI      LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4.1-mini
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=anthropic/claude-sonnet-4.6
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=qwen2.5:7b  (không cần khoá)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Số câu hỏi mỗi người mỗi giờ
AI_ASKS_PER_HOUR=20
