# Mẫu cấu hình. Chép thành .env rồi điền giá trị thật.
#
# File này đi lên git, .env thì không. Đừng điền giá trị thật vào đây: một khóa đã lên git
# là một khóa đã lộ, kể cả khi commit sau đó xóa nó đi — lịch sử vẫn còn.

# ---------------------------------------------------------------- bắt buộc

# Chuỗi ký tự dùng để ký token đăng nhập. TỐI THIỂU 32 KÝ TỰ.
# Không có giá trị mặc định trong mã nguồn: thiếu biến này thì ứng dụng dừng ngay lúc khởi
# động thay vì chạy tiếp với một khóa ai cũng đoán được.
# Sinh một chuỗi ngẫu nhiên: openssl rand -base64 48
JWT_SECRET=
TEACHER_INITIAL_PASSWORD=123456

# Kết nối cơ sở dữ liệu PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/tkb_db?schema=public"

# ---------------------------------------------------------------- mạng

# Cổng máy chủ API
PORT=4000

# Những địa chỉ được phép gọi API, phân tách bằng dấu phẩy.
# Để trống thì chỉ localhost:3000 gọi được. Đừng đặt dấu * ở môi trường thật.
CORS_ORIGIN=http://localhost:3000

# Địa chỉ công khai của giao diện, dùng để sinh liên kết trong mã QR cho giáo viên
PUBLIC_WEB_URL=http://localhost:3000

# ---------------------------------------------------------------- Redis
# Dùng cho captcha, giới hạn số lần đăng nhập sai, và hàng đợi chạy thuật toán

REDIS_HOST=localhost
REDIS_PORT=6379

# ---------------------------------------------------------------- trợ lý AI
# Bỏ trống cả ba thì trợ lý tự tắt, phần còn lại của hệ thống vẫn chạy bình thường.

LLM_BASE_URL=https://airouter.mikitech.io/api/v1
LLM_API_KEY=
LLM_MODEL=cxgptsol
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Số câu hỏi tối đa một người được hỏi trợ lý trong một giờ

# ---------------------------------------------------------------- tuỳ chọn

# Số nước đi cho một lần tìm kiếm. Bỏ trống thì hệ thống tự tính theo số tiết phải xếp.
# Đặt nhỏ lại thì xếp nhanh hơn nhưng thời khóa biểu kém hơn.
# TKB_SEARCH_MAIN=

# ---- Dang nhap buoc 2: ma OTP 6 so qua email (bat buoc voi moi tai khoan) ----
ADMIN_EMAIL=admin@truong.edu.vn
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxx
SMTP_FROM=MiKiTimetable <no-reply@gettimetable.cloud>
OTP_ENABLED=true
