
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// GROUP 1: SYSTEM & CONFIG
// ==========================================

model AcademicYear {
  id          String   @id @default(uuid())
  name        String   // "2024-2025"
  start_date  DateTime
  end_date    DateTime
  weeks       Int      @default(35)
  status      YearStatus @default(ACTIVE)

  semesters   Semester[]

  @@map("academic_years")
}

enum YearStatus {
  ACTIVE
  ARCHIVED
}

model Semester {
  id          String   @id @default(uuid())
  year_id     String
  name        String   // "HK1"
  is_current  Boolean  @default(false)
  term_order  Int      @default(1)
  start_date  DateTime?
  end_date    DateTime?

  academic_year         AcademicYear @relation(fields: [year_id], references: [id])
  teaching_assignments  TeachingAssignment[]
  generated_timetables  GeneratedTimetable[]
  overlays              ScheduleOverlay[]
  busy_requests         TeacherBusyRequest[]

  @@map("semesters")
}



// ==========================================
// GROUP 2: RESOURCES
// ==========================================

model Room {
  id          Int      @id @default(autoincrement())
  name        String   // "101", "Lab Ly"
  type        RoomType @default(CLASSROOM)
  floor       Int      // 1, 2, 3
  capacity    Int      @default(45)

  classes           Class[] // Fixed rooms for classes
  timetable_slots   TimetableSlot[]

  @@map("rooms")
}

enum RoomType {
  CLASSROOM
  LAB_PHYSICS
  LAB_CHEM
  LAB_BIO
  LAB_IT
  YARD
  MULTI_PURPOSE
}

model Subject {
  id          Int      @id @default(autoincrement())
  code        String   @unique // "TOAN", "LY"
  name        String   // "Toan Hoc"
  color       String   // "#FF5733"
  is_special  Boolean  @default(false) // Flag Raising, SHCN, GDQP
  is_practice Boolean  @default(false)

  teaching_assignments TeachingAssignment[]
  timetable_slots      TimetableSlot[]

  @@map("subjects")
}

// ==========================================
// GROUP 3: HUMAN RESOURCES
// ==========================================

model User {
  id                String   @id @default(uuid())
  username          String   @unique
  password_hash     String
  role              UserRole @default(TEACHER)
  
  teacher_profile_id String? @unique
  teacher_profile    Teacher? @relation(fields: [teacher_profile_id], references: [id])
  
  created_at        DateTime @default(now())

  @@map("users")
}

enum UserRole {
  ADMIN
  TEACHER
}

model Teacher {
  id                  String   @id @default(uuid())
  code                String   @unique // "GV001"
  full_name           String
  short_name          String?  // "Huong Van" - displayed on small slots
  email               String?
  phone               String?
  major_subject       String?  // Môn chuyên môn chính: "TOAN", "LY"
  teachable_grades    String?  // JSON: [10,11,12] — Khối có thể dạy
  position            String   @default("GV") // GV, HT, PHT, TT, TP
  max_periods_per_week Int      @default(20)
  department          String?
  status              String   @default("Dang_day")
  workload_reduction  Int      @default(0)
  /// How heavily stair climbing counts for this teacher, in tenths. 10 = normal;
  /// raise it for older teachers or anyone with a mobility difficulty.
  mobility_weight     Int      @default(10)
  notes               String?

  user                User?

  homeroom_classes    Class[]
  constraints         TeacherConstraint[]
  teaching_assignments TeachingAssignment[]
  timetable_slots     TimetableSlot[]
  busy_requests       TeacherBusyRequest[]

  @@map("teachers")
}

model TeacherConstraint {
  id          Int      @id @default(autoincrement())
  teacher_id  String
  day_of_week Int      // 2-7
  period      Int      // 1-5
  session     Int      // 0: Morning, 1: Afternoon
  type        ConstraintType

  teacher     Teacher  @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@index([teacher_id, day_of_week, period]) // Read-optimized constraint check
  @@map("teacher_constraints")
}

/// The three things a teacher can say about a time slot.
///
/// BUSY is a fact about their life the timetable must respect. AVOID and PREFER are
/// wishes, and separating them matters: a system that treats every request as absolute
/// either refuses to build a timetable or quietly ignores the requests it cannot meet.
enum ConstraintType {
  BUSY   // Hard: khong the day - hop, di hoc, con nho
  AVOID  // Soft: day duoc nhung khong muon - bi tru diem
  PREFER // Soft: mong muon day gio nay - duoc cong diem
}

enum BusyStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==========================================
// GROUP 4: ORGANIZATION
// ==========================================

model Class {
  id                  String   @id @default(uuid())
  name                String   // "10A1"
  grade_level         Int      // 10, 11, 12
  main_session        Int      // 0: Morning, 1: Afternoon
  student_count       Int?
  combination_code    String?
  notes               String?
  
  fixed_room_id       Int?
  fixed_room          Room?    @relation(fields: [fixed_room_id], references: [id])

  homeroom_teacher_id String?
  homeroom_teacher    Teacher? @relation(fields: [homeroom_teacher_id], references: [id])

  teaching_assignments TeachingAssignment[]
  timetable_slots      TimetableSlot[]

  @@map("classes")
}

/// An admin override for one constraint's weight or on/off state.
///
/// Only the override lives here - the constraint's name, kind and default weight stay in
/// `constraint-catalogue.ts` next to the code that applies them. Storing the text in the
/// database as well would let the screen describe a constraint the solver no longer has.
model ConstraintSetting {
  key        String   @id
  weight     Int
  is_active  Boolean  @default(true)
  updated_at DateTime @updatedAt

  @@map("constraint_settings")
}

/// A period the school pins to a set time before the solver runs - chào cờ, sinh hoạt,
/// GDĐP and so on. Replaces the rules that used to be hardcoded in the algorithm so a
/// school can arrange its own fixed periods and lock them from the admin screen.
model FixedPeriodRule {
  id           String  @id @default(uuid())
  name         String  // "Chào cờ đầu tuần"
  subject_code String  // "CHAO_CO", or "GVCN_TEACHING" for the homeroom teacher's own lesson
  day_of_week  Int     // 2-7
  period       Int     // 1-10, absolute within the day
  grade_level  Int?    // null = every grade
  main_session Int?    // null = every session; 0 = morning classes, 1 = afternoon classes
  teacher_rule TeacherRule @default(HOMEROOM)
  is_locked    Boolean @default(true) // slot cannot be moved by the solver or by drag & drop
  is_active    Boolean @default(true)
  sort_order   Int     @default(0)

  @@index([is_active, day_of_week, period])
  @@map("fixed_period_rules")
}

enum TeacherRule {
  HOMEROOM // giáo viên chủ nhiệm của lớp
  BGH      // ban giám hiệu / giáo viên hệ thống
  ASSIGNED // giáo viên đang được phân công dạy môn đó cho lớp
}

model CurriculumCombination {
  id                      String @id @default(uuid())
  code                    String
  grade_level             Int
  elective_subject_code_1 String
  elective_subject_code_2 String
  elective_subject_code_3 String
  elective_subject_code_4 String
  special_topic_code_1    String?
  special_topic_code_2    String?
  special_topic_code_3    String?
  notes                   String?

  @@unique([code, grade_level])
  @@map("curriculum_combinations")
}

// ==========================================
// GROUP 5: ASSIGNMENTS (INPUT)
// ==========================================

model TeachingAssignment {
  id                  String   @id @default(uuid())
  semester_id         String
  class_id            String
  teacher_id          String
  subject_id          Int
  
  total_periods       Int      // e.g. 3
  period_type         PeriodType @default(THEORY)
  required_room_type  RoomType?  // Nullable, strictly set if PRACTICE
  block_config        String?    // "2+1"

  semester            Semester @relation(fields: [semester_id], references: [id])
  class               Class    @relation(fields: [class_id], references: [id])
  teacher             Teacher  @relation(fields: [teacher_id], references: [id])
  subject             Subject  @relation(fields: [subject_id], references: [id])

  @@map("teaching_assignments")
}

enum PeriodType {
  THEORY
  PRACTICE
  SPECIAL
}

// ==========================================
// GROUP 6: TIMETABLE (OUTPUT)
// ==========================================

model GeneratedTimetable {
  id            String   @id @default(uuid())
  name          String
  semester_id   String
  is_official   Boolean  @default(false)
  fitness_score Float?
  /// Unguessable id for the read-only public link teachers reach by QR code.
  /// Issued when the timetable is published; a draft has none.
  public_token  String?  @unique
  created_at    DateTime @default(now())

  semester      Semester @relation(fields: [semester_id], references: [id])
  slots         TimetableSlot[]
  change_logs   TimetableChangeLog[]

  @@map("generated_timetables")
}

/// Every manual change to a generated timetable. Without this the school has no way to
/// answer "who moved this and why", and no way back if an edit turns out wrong.
model TimetableChangeLog {
  id           String   @id @default(uuid())
  timetable_id String
  slot_id      String?
  actor_id     String?
  actor_name   String
  action       ChangeAction
  description  String
  /// Enough state to reverse the change: [{ slotId, day, period, isLocked }]
  before       Json
  after        Json
  reverted     Boolean  @default(false)
  created_at   DateTime @default(now())

  timetable    GeneratedTimetable @relation(fields: [timetable_id], references: [id], onDelete: Cascade)

  @@index([timetable_id, created_at])
  @@map("timetable_change_logs")
}

enum ChangeAction {
  MOVE
  SWAP
  CASCADE_SWAP
  LOCK
  UNLOCK
  PUBLISH
  REVERT
}

/// A dated change laid over the master timetable: a holiday, an absent teacher, an exam
/// week. The master schedule is generated once a term and stays untouched; editing it
/// directly is how a timetable becomes wrong by week three and abandoned by week six.
model ScheduleOverlay {
  id          String       @id @default(uuid())
  semester_id String
  type        OverlayType
  scope       OverlayScope @default(SCHOOL)
  /// Which class or teacher the overlay applies to, when the scope is not SCHOOL
  scope_ref   String?
  date_from   DateTime     @db.Date
  date_to     DateTime     @db.Date
  /// Higher priority overrides lower when two overlays touch the same period
  priority    Int          @default(10)
  /// What changes. For ABSENCE: { absentTeacherId, coverage: [{ slotId, mode, substituteTeacherId }] }
  payload     Json
  reason      String?
  created_by  String?
  created_at  DateTime     @default(now())

  semester    Semester     @relation(fields: [semester_id], references: [id], onDelete: Cascade)

  @@index([semester_id, date_from, date_to])
  @@map("schedule_overlays")
}

enum OverlayType {
  HOLIDAY   // nghỉ lễ
  ABSENCE   // giáo viên nghỉ, có người dạy thay
  EXAM_WEEK // tuần kiểm tra
  EVENT     // hoạt động ngoại khóa
  MAKEUP    // dạy bù
  SWAP      // đổi tiết đã duyệt
}

enum OverlayScope {
  SCHOOL
  GRADE
  CLASS
  TEACHER
}

model TimetableSlot {
  id            String   @id @default(uuid())
  timetable_id  String
  class_id      String
  subject_id    Int
  teacher_id    String
  room_id       Int?     // Map to physical room (Fixed or Lab)

  day           Int      // 2-7
  period        Int      // 1-10
  week          Int      @default(1) // nth week of semester (1-based)
  is_locked     Boolean  @default(false)

  timetable     GeneratedTimetable @relation(fields: [timetable_id], references: [id], onDelete: Cascade)
  class         Class   @relation(fields: [class_id], references: [id])
  subject       Subject @relation(fields: [subject_id], references: [id])
  teacher       Teacher @relation(fields: [teacher_id], references: [id])
  room          Room?   @relation(fields: [room_id], references: [id])

  @@unique([timetable_id, class_id, day, period, week], name: "unique_class_slot")
  @@unique([timetable_id, teacher_id, day, period, week], name: "unique_teacher_slot")
  @@unique([timetable_id, room_id, day, period, week], name: "unique_room_slot")

  @@map("timetable_slots")
}

// ==========================================
// GROUP 7: TEACHER BUSY REQUESTS
// ==========================================

model TeacherBusyRequest {
  id              String     @id @default(uuid())
  teacher_id      String
  semester_id     String
  week_number     Int
  day_of_week     Int        // 2-7
  period          Int        // 1-10
  reason          String
  status          BusyStatus @default(PENDING)
  rejection_note  String?
  reviewed_by     String?    // admin user_id
  reviewed_at     DateTime?
  created_at      DateTime   @default(now())

  teacher         Teacher    @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  semester        Semester   @relation(fields: [semester_id], references: [id], onDelete: Cascade)

  @@unique([teacher_id, semester_id, week_number, day_of_week, period])
  @@index([teacher_id, semester_id, status])
  @@map("teacher_busy_requests")
}

// ==========================================
// GROUP 8: NOTIFICATIONS
// ==========================================

model Notification {
  id          String   @id @default(uuid())
  user_id     String?  // Recipient user ID (null = broadcast to all admins)
  category    NotificationCategory
  title       String
  message     String
  metadata    Json?    // Extra info (e.g. teacher name, import stats)
  is_read     Boolean  @default(false)
  created_at  DateTime @default(now())

  @@index([user_id, is_read, created_at])
  @@map("notifications")
}

enum NotificationCategory {
  IMPORT        // Excel import results
  TIMETABLE     // TKB generation status
  FEEDBACK      // Teacher feedback/request
  BUSY_SCHEDULE // Teacher busy time registration
  SYSTEM        // General system events
}
